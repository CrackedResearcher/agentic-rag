# Gemini API key — required. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Tavily API key — optional, enables the web search tool. https://tavily.com
TV_API_KEY=

# Corpus to index and the directory to store the index in (optional).
# Both are overridden by the --docs / --data flags.
# DOCS_DIR=~/work/handbook
# DATA_DIR=~/.agentic-rag/handbook

# Persona the agent adopts (optional)
ASSISTANT_NAME=Sam
ORGANIZATION=Acme Corp

# Colour palette (optional): nord, catppuccin, gruvbox, solarized, dracula
# Preview them with: agentic-rag themes
THEME=nord
